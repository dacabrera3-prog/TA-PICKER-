<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="CarrionSem2.Inicio"
             Title="Registro">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" BackgroundColor="White">

            <!-- Encabezado -->
            <Label Text="FASE A - GRADO" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#003366" 
                   HorizontalOptions="Center" />

            <Label Text="Formulario de registro" 
                   FontSize="16" 
                   TextColor="#333333" 
                   HorizontalOptions="Center" />

            <Label Text="Complete la siguiente información para realizar su inscripción." 
                   FontSize="14" 
                   TextColor="#666666" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,20" />

            <!-- Contenedor principal de Datos Personales -->
            <Grid>
                <!-- Título flotante simulado para "Datos Personales" -->
                <RoundRectangle CornerRadius="4" Stroke="#CCCCCC" StrokeThickness="1" Margin="0,10,0,0"/>

                <Label Text=" Datos Personales " 
                       TextColor="#888888" 
                       BackgroundColor="White" 
                       Margin="15,2,0,0" 
                       HorizontalOptions="Start" 
                       VerticalOptions="Start"/>

                <Grid Padding="20,25,20,20" RowSpacing="15" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <!-- Columna de Labels -->
                        <ColumnDefinition Width="*" />
                        <!-- Columna Input 1 -->
                        <ColumnDefinition Width="*" />
                        <!-- Columna Input 2 -->
                    </Grid.ColumnDefinitions>

                    <!-- Identificación -->
                    <Label Text="Identificación:" VerticalOptions="Center" Grid.Row="0" Grid.Column="0" TextColor="#333333" />
                    <Picker Title="CÉDULA" Grid.Row="0" Grid.Column="1" TextColor="#333333">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>CÉDULA</x:String>
                                <x:String>PASAPORTE</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <Entry Placeholder="Número" Grid.Row="0" Grid.Column="2" Keyboard="Numeric" />

                    <!-- Apellidos -->
                    <Label Text="Apellidos:" VerticalOptions="Center" Grid.Row="1" Grid.Column="0" TextColor="#333333" />
                    <Entry Placeholder="Paterno" Grid.Row="1" Grid.Column="1" />
                    <Entry Placeholder="Materno" Grid.Row="1" Grid.Column="2" />

                    <!-- Nombres completos -->
                    <Label Text="Nombres completos:" VerticalOptions="Center" Grid.Row="2" Grid.Column="0" TextColor="#333333" />
                    <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" />

                    <!-- Teléfono personal -->
                    <Label Text="Teléfono personal:" VerticalOptions="Center" Grid.Row="3" Grid.Column="0" TextColor="#333333" />
                    <Entry Placeholder="________" Grid.Row="3" Grid.Column="1" Keyboard="Telephone" />

                    <!-- Correo personal -->
                    <Label Text="Correo personal:" VerticalOptions="Center" Grid.Row="4" Grid.Column="0" TextColor="#333333" />
                    <Entry Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Keyboard="Email" />

                    <!-- Confirmar correo -->
                    <Label Text="Confirmar correo:" VerticalOptions="Center" Grid.Row="5" Grid.Column="0" TextColor="#333333" />
                    <Entry Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Keyboard="Email" />
                </Grid>
            </Grid>

            <!-- Botón de acción -->
            <Button Text="Registrar" 
                    BackgroundColor="#003366" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    Margin="0,20,0,0" 
                    Clicked="OnRegistrarClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>